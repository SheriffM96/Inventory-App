generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STOREKEEPER
  KITCHEN
  BAR
  MANAGER
}

enum Team {
  KITCHEN
  BAR
  CLEANING
}

model User {
  id        String   @id @default(cuid())
  name      String
  pinHash   String
  role      Role
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  purchases   Purchase[]
  issuances   Issuance[]
  usages      Usage[]
  stockCounts StockCount[]
}

model Item {
  id           String   @id @default(cuid())
  name         String   @unique
  category     String
  unit         String
  openingStock Decimal  @default(0) @db.Decimal(12, 2)
  reorderLevel Decimal? @db.Decimal(12, 2)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  purchases   Purchase[]
  issuances   Issuance[]
  usages      Usage[]
  stockCounts StockCount[]
}

model Vendor {
  id        String   @id @default(cuid())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  purchases Purchase[]
}

model Recipient {
  id        String   @id @default(cuid())
  name      String
  team      Team
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  issuances Issuance[]
}

model Purchase {
  id         String   @id @default(cuid())
  item       Item     @relation(fields: [itemId], references: [id])
  itemId     String
  quantity   Decimal  @db.Decimal(12, 2)
  totalCost  Decimal  @db.Decimal(12, 2)
  vendor     Vendor   @relation(fields: [vendorId], references: [id])
  vendorId   String
  date       DateTime @default(now())
  notes      String?
  loggedBy   User     @relation(fields: [loggedById], references: [id])
  loggedById String
  createdAt  DateTime @default(now())

  @@index([date])
  @@index([itemId])
}

/// Storekeeper issues stock out to a named person on the kitchen, bar, or
/// cleaning team. This is what reduces the central/storekeeper stock balance.
model Issuance {
  id          String    @id @default(cuid())
  item        Item      @relation(fields: [itemId], references: [id])
  itemId      String
  quantity    Decimal   @db.Decimal(12, 2)
  recipient   Recipient @relation(fields: [recipientId], references: [id])
  recipientId String
  date        DateTime  @default(now())
  notes       String?
  loggedBy    User      @relation(fields: [loggedById], references: [id])
  loggedById  String
  createdAt   DateTime  @default(now())

  @@index([date])
  @@index([itemId])
}

/// Kitchen/Bar staff logging their own consumption during service. Does not
/// affect the central stock balance - that already left when issued.
model Usage {
  id         String   @id @default(cuid())
  item       Item     @relation(fields: [itemId], references: [id])
  itemId     String
  quantity   Decimal  @db.Decimal(12, 2)
  department Team
  date       DateTime @default(now())
  notes      String?
  loggedBy   User     @relation(fields: [loggedById], references: [id])
  loggedById String
  createdAt  DateTime @default(now())

  @@index([date])
  @@index([itemId])
}

/// A physical stock take (count) of an item at a point in time. The most
/// recent count for an item becomes the new baseline that purchases and
/// issuances are added to/subtracted from going forward, replacing the
/// item's original openingStock for that purpose.
model StockCount {
  id         String   @id @default(cuid())
  item       Item     @relation(fields: [itemId], references: [id])
  itemId     String
  quantity   Decimal  @db.Decimal(12, 2)
  date       DateTime @default(now())
  notes      String?
  loggedBy   User     @relation(fields: [loggedById], references: [id])
  loggedById String
  createdAt  DateTime @default(now())

  @@index([date])
  @@index([itemId])
}

model NotificationLog {
  id        String   @id @default(cuid())
  event     String
  message   String
  sentOk    Boolean  @default(false)
  error     String?
  createdAt DateTime @default(now())
}
