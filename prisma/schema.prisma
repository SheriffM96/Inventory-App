generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STOREKEEPER
  KITCHEN
  BAR
  MANAGER
  SUPERVISOR
}

enum Team {
  KITCHEN
  BAR
  CLEANING
}

enum ReconciliationStatus {
  PENDING
  CONFIRMED
  DISPUTED
}

model User {
  id        String   @id @default(cuid())
  name      String
  pinHash   String
  role      Role
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  purchases              Purchase[]
  issuances              Issuance[]
  usages                 Usage[]
  stockCounts            StockCount[]
  submittedReconciliations DailyReconciliation[] @relation("ReconciliationSubmittedBy")
  reviewedReconciliations DailyReconciliation[]  @relation("ReconciliationReviewedBy")
}

model Item {
  id           String   @id @default(cuid())
  name         String   @unique
  category     String
  unit         String
  openingStock Decimal  @default(0) @db.Decimal(12, 2)
  reorderLevel Decimal? @db.Decimal(12, 2)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  purchases   Purchase[]
  issuances   Issuance[]
  usages      Usage[]
  stockCounts StockCount[]
}

model Vendor {
  id        String   @id @default(cuid())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  purchases Purchase[]
}

model Recipient {
  id        String   @id @default(cuid())
  name      String
  team      Team
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  issuances Issuance[]
}

model Purchase {
  id         String   @id @default(cuid())
  item       Item     @relation(fields: [itemId], references: [id])
  itemId     String
  quantity   Decimal  @db.Decimal(12, 2)
  totalCost  Decimal  @db.Decimal(12, 2)
  vendor     Vendor   @relation(fields: [vendorId], references: [id])
  vendorId   String
  date       DateTime @default(now())
  notes      String?
  loggedBy   User     @relation(fields: [loggedById], references: [id])
  loggedById String
  createdAt  DateTime @default(now())

  @@index([date])
  @@index([itemId])
}

/// Storekeeper issues stock out to a named person on the kitchen, bar, or
/// cleaning team. This is what reduces the central/storekeeper stock balance.
model Issuance {
  id          String    @id @default(cuid())
  item        Item      @relation(fields: [itemId], references: [id])
  itemId      String
  quantity    Decimal   @db.Decimal(12, 2)
  recipient   Recipient @relation(fields: [recipientId], references: [id])
  recipientId String
  date        DateTime  @default(now())
  notes       String?
  loggedBy    User      @relation(fields: [loggedById], references: [id])
  loggedById  String
  createdAt   DateTime  @default(now())

  @@index([date])
  @@index([itemId])
}

/// Kitchen/Bar staff logging their own consumption during service. Does not
/// affect the central stock balance - that already left when issued.
model Usage {
  id         String   @id @default(cuid())
  item       Item     @relation(fields: [itemId], references: [id])
  itemId     String
  quantity   Decimal  @db.Decimal(12, 2)
  department Team
  date       DateTime @default(now())
  notes      String?
  loggedBy   User     @relation(fields: [loggedById], references: [id])
  loggedById String
  createdAt  DateTime @default(now())

  @@index([date])
  @@index([itemId])
}

/// A physical stock take (count) of an item at a point in time. The most
/// recent count for an item becomes the new baseline that purchases and
/// issuances are added to/subtracted from going forward, replacing the
/// item's original openingStock for that purpose.
model StockCount {
  id         String   @id @default(cuid())
  item       Item     @relation(fields: [itemId], references: [id])
  itemId     String
  quantity   Decimal  @db.Decimal(12, 2)
  date       DateTime @default(now())
  notes      String?
  loggedBy   User     @relation(fields: [loggedById], references: [id])
  loggedById String
  createdAt  DateTime @default(now())

  @@index([date])
  @@index([itemId])
}

/// A sellable menu dish/drink (e.g. "Chicken Shawarma", "Mint Mocktail") -
/// distinct from Item, which is a raw ingredient tracked for stock purposes.
/// Used to record what was actually sold each day, separate from ingredient
/// usage logged by kitchen/bar.
model MenuItem {
  id        String   @id @default(cuid())
  name      String   @unique
  category  String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  saleLines SaleLine[]
}

/// The supervisor's end-of-day submission: total sales broken down by
/// payment method. The manager reviews it against the bank (POS/transfer)
/// and physical cash handed to them, then marks it Confirmed or Disputed.
/// One per calendar day - `date` is normalized to the start of that day.
model DailyReconciliation {
  id            String               @id @default(cuid())
  date          DateTime             @unique
  cashTotal     Decimal              @db.Decimal(12, 2)
  transferTotal Decimal              @db.Decimal(12, 2)
  posTotal      Decimal              @db.Decimal(12, 2)
  notes         String?
  status        ReconciliationStatus @default(PENDING)
  managerNotes  String?
  submittedBy   User                 @relation("ReconciliationSubmittedBy", fields: [submittedById], references: [id])
  submittedById String
  reviewedBy    User?                @relation("ReconciliationReviewedBy", fields: [reviewedById], references: [id])
  reviewedById  String?
  reviewedAt    DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  saleLines SaleLine[]

  @@index([date])
}

/// Quantity sold of one menu item within a day's reconciliation.
model SaleLine {
  id               String              @id @default(cuid())
  reconciliation   DailyReconciliation @relation(fields: [reconciliationId], references: [id])
  reconciliationId String
  menuItem         MenuItem            @relation(fields: [menuItemId], references: [id])
  menuItemId       String
  quantitySold     Decimal             @db.Decimal(12, 2)

  @@unique([reconciliationId, menuItemId])
}

model NotificationLog {
  id        String   @id @default(cuid())
  event     String
  message   String
  sentOk    Boolean  @default(false)
  error     String?
  createdAt DateTime @default(now())
}
