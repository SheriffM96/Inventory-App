# PostgreSQL connection string (Neon, Supabase, Railway, etc.)
# Example Neon format: postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/mishkak?sslmode=require
DATABASE_URL="postgresql://user:password@host:5432/mishkak?sslmode=require"

# Random secret used to sign login session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-with-a-long-random-string"

# --- WhatsApp notifications (optional, not required to run the app) ---
# Leave blank to disable. See README "Adding WhatsApp notifications" section.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM=""
MANAGER_WHATSAPP_TO=""
